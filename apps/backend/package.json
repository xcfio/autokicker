{
    "name": "backend",
    "type": "commonjs",
    "author": "xcfio",
    "license": "MIT",
    "scripts": {
        "build": "node --experimental-strip-types build.cts",
        "dev": "tsx watch --include src/**/* --no-warnings --env-file-if-exists=.env src/index.ts",
        "docker:build": "docker build --tag api .",
        "docker:start": "docker run --detach --rm --publish 7200:7200 api",
        "fmt": "prettier --config=.prettierrc --write src",
        "fmt:test": "prettier --config=.prettierrc --check src",
        "gen": "drizzle-kit generate",
        "start": "node --env-file-if-exists=.env out/index.js",
        "test": "tsc --noEmit"
    },
    "dependencies": {
        "@fastify/auth": "^5.1.2",
        "@fastify/cookie": "^11.1.5",
        "@fastify/cors": "^11.3.1",
        "@fastify/error": "^4.2.1",
        "@fastify/jwt": "^10.2.5",
        "@fastify/oauth2": "^8.3.2",
        "@fastify/rate-limit": "^11.2.1",
        "@fastify/swagger": "^9.9.2",
        "@fastify/type-provider-typebox": "^6.3.0",
        "@repo/database": "workspace:*",
        "@repo/schema": "workspace:*",
        "@repo/utils": "workspace:*",
        "@scalar/fastify-api-reference": "^1.76.0",
        "@socket.io/admin-ui": "^0.5.1",
        "discord-api-types": "^0.38.57",
        "fastify": "^5.12.7",
        "fastify-utils": "^0.0.4",
        "postgres": "^3.4.9",
        "snowtransfer": "^0.19.1",
        "socket.io": "^4.8.4",
        "typebox": "^1.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "rolldown": "^1.2.15"
    }
}
